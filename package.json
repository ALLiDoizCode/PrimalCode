{
  "name": "primalcode",
  "version": "1.0.0",
  "description": "PrimalCode - Autonomous Ecosystem Management MCP Server",
  "main": "dist/index.js",
  "bin": {
    "primalcode": "dist/index.js"
  },
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "dev": "npm run build:watch",
    "start": "node dist/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write src/**/*.ts tests/**/*.ts",
    "format:check": "prettier --check src/**/*.ts tests/**/*.ts",
    "pre-commit": "npm run check-no-logging && npm run lint",
    "check-no-logging": "if grep -r 'console\\.' src/ || grep -r 'process\\.stdout\\.' src/ || grep -r 'process\\.stderr\\.' src/; then echo 'ERROR: Console logging detected in src/. MCP servers using stdio cannot use console logging.'; exit 1; fi"
  },
  "keywords": [
    "mcp",
    "server",
    "ecosystem",
    "autonomous",
    "typescript"
  ],
  "author": "PrimalCode Team",
  "license": "ISC",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.15.1",
    "axios": "^1.10.0",
    "dotenv": "^16.6.1",
    "fastmcp": "^3.9.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^24.0.14",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "prettier": "^3.6.2",
    "ts-jest": "^29.4.0",
    "typescript": "^5.8.3"
  }
}
